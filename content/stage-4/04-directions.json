      "id": "s4.directions.get-to-station",
      "type": "phrase",
      "stage": 4,
      "module": "s4.directions",
      "order": 1,
      "en": "Excuse me, how do I get to the station?",
      "pl": "Przepraszam, jak dojść do dworca?",
      "alternatives": [
        "Excuse me, where's the station?",
        "Excuse me, which way is the station?"
      ],
      "usage": "Klasyczne pytanie o drogę.",
      "register": "neutral",
      "example": [
        {
          "en": "Excuse me, how do I get to the station? — Go straight on and turn left.",
          "pl": "Przepraszam, jak dojść do dworca? — Prosto i w lewo."
