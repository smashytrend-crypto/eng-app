  "items": [
    {
      "id": "s5.past.what-did-you-do-weekend",
      "type": "phrase",
      "stage": 5,
      "module": "s5.past",
      "order": 1,
      "en": "What did you do at the weekend?",
      "pl": "Co robiłeś w weekend?",
      "alternatives": [
        "What did you do on the weekend?",
        "What did you get up to at the weekend?"
      ],
      "usage": "Pytanie o przeszłość — z „did”.",
      "register": "neutral",
      "example": [
        {
          "en": "What did you do at the weekend? — I went to Berlin.",
          "pl": "Co robiłeś w weekend? — Byłem w Berlinie."
        }
      ],
      "note": "Pytanie w przeszłości: did + czasownik w formie podstawowej (do, go), nie „did you went”.",
      "tags": [
        "gr:past-simple",
        "gr:questions-do",
        "polish-trap"
      ],
      "level": "A2"
    },
    {
      "id": "s5.past.party-friends-place",
      "type": "phrase",
      "stage": 5,
      "module": "s5.past",
      "order": 2,
      "en": "I went to a party at a friend's place.",
      "pl": "Byłem na imprezie u kumpla.",
      "alternatives": [
        "I went to a party at my friend's place.",
        "I went to a party at a friend's house."
      ],
      "usage": "Opowiadasz, co robiłeś.",
      "register": "neutral",
      "example": [
        {
          "en": "I went to a party at a friend's place. It was great.",
          "pl": "Byłem na imprezie u kumpla. Było super."
        }
      ],
      "note": "„Byłem na imprezie” = „I went to a party” — po angielsku częściej „went” niż „was”.",
      "tags": [
        "gr:past-simple"
      ],
      "level": "A2"
    },
    {
