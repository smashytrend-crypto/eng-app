      "usage": "Spokojny weekend.",
      "register": "neutral",
      "example": [
        {
          "en": "How was your weekend? — Quiet. I didn't do much.",
          "pl": "Jak weekend? — Spokojnie. Nic specjalnego nie robiłem."
