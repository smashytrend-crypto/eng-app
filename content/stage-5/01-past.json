{
  "module": {
    "id": "s5.past",
    "stage": 5,
    "order": 1,
    "title": "Co się wydarzyło",
    "titleEn": "What happened",
    "description": "Past Simple w praktyce: co robiłeś w weekend, gdzie byłeś, kogo poznałeś. Najczęstsze nieregularne czasowniki i pytania z „did”.",
