  "items": [
    {
      "id": "s5.future.probably-stay-home",
      "type": "phrase",
      "stage": 5,
      "module": "s5.future",
      "order": 1,
      "en": "I'll probably stay at home.",
      "pl": "Pewnie zostanę w domu.",
      "alternatives": [
        "I'll probably stay home.",
        "Probably stay at home."
      ],
      "usage": "„Will” + „probably” — przypuszczenie o sobie.",
      "register": "neutral",
      "example": [
        {
          "en": "What are you doing tonight? — I'll probably stay at home.",
          "pl": "Co robisz wieczorem? — Pewnie zostanę w domu."
        }
      ],
      "note": "„Probably” stoi po „will”: I'll probably go. W przeczeniu przed: I probably won't.",
      "tags": [
        "future"
      ],
      "level": "A2"
    },
    {
      "id": "s5.future.might-go",
      "type": "phrase",
      "stage": 5,
      "module": "s5.future",
      "order": 2,
      "en": "I'm not sure yet — I might go.",
      "pl": "Jeszcze nie wiem — może pójdę.",
      "alternatives": [
        "I'm not sure. I might go.",
        "I might go, not sure yet."
      ],
      "usage": "„Might” = może (niepewne).",
      "register": "neutral",
      "example": [
        {
          "en": "Are you coming to the party? — I'm not sure yet — I might go.",
          "pl": "Idziesz na imprezę? — Jeszcze nie wiem — może pójdę."
        }
      ],
      "tags": [
        "future"
      ],
      "level": "B1"
    },
