{
  "module": {
    "id": "s5.storytelling",
    "stage": 5,
    "order": 2,
    "title": "Opowiadanie historii",
    "titleEn": "Telling stories",
    "description": "Jak opowiadać ciekawie: początek, zwroty akcji, „okazało się”, „krótko mówiąc”, najlepsza i najgorsza część.",
    "tags": [
      "general"
    ]
  },
  "items": [
    {
      "id": "s5.storytelling.wont-believe",
      "type": "phrase",
      "stage": 5,
      "module": "s5.storytelling",
      "order": 1,
      "en": "You won't believe what happened!",
      "pl": "Nie uwierzysz, co się stało!",
      "alternatives": [
        "You'll never believe what happened!"
      ],
      "usage": "Idealny początek historii.",
      "register": "casual",
      "example": [
        {
          "en": "You won't believe what happened! I met Amelie Lens at the airport!",
          "pl": "Nie uwierzysz, co się stało! Spotkałem Amelie Lens na lotnisku!"
        }
      ],
      "tags": [
        "story"
      ],
      "level": "A2"
    },
    {
      "id": "s5.storytelling.guess-what",
      "type": "phrase",
      "stage": 5,
      "module": "s5.storytelling",
      "order": 2,
      "en": "Guess what!",
      "pl": "Zgadnij co!",
      "alternatives": [],
      "usage": "Gdy masz newsa.",
      "register": "casual",
      "example": [
        {
          "en": "Guess what! I got the tickets!",
          "pl": "Zgadnij co! Mam bilety!"
        }
      ],
      "tags": [
        "story"
      ],
      "level": "A2"
    },
    {
      "id": "s5.storytelling.long-story-short",
      "type": "phrase",
      "stage": 5,
      "module": "s5.storytelling",
      "order": 3,
      "en": "Long story short, we missed the last train.",
      "pl": "Krótko mówiąc, uciekł nam ostatni pociąg.",
      "alternatives": [
        "To cut a long story short, we missed the last train."
      ],
      "usage": "Skracasz długą historię.",
      "register": "neutral",
      "example": [
        {
          "en": "Long story short, we missed the last train and slept at the station.",
          "pl": "Krótko mówiąc, uciekł nam ostatni pociąg i spaliśmy na dworcu."
        }
      ],
      "tags": [
        "story",
        "gr:past-simple"
      ],
      "level": "B1"
    },
    {
      "id": "s5.storytelling.out-of-nowhere",
      "type": "phrase",
      "stage": 5,
      "module": "s5.storytelling",
      "order": 4,
      "en": "And then, out of nowhere…",
      "pl": "I nagle, znikąd…",
      "alternatives": [
        "And then suddenly…"
      ],
      "usage": "Budujesz napięcie.",
      "register": "neutral",
      "example": [
        {
          "en": "We were dancing, and then, out of nowhere, it started pouring.",
          "pl": "Tańczyliśmy, i nagle, znikąd, zaczęło lać."
        }
      ],
      "tags": [
        "story"
      ],
      "level": "B1"
    },
    {
      "id": "s5.storytelling.where-was-i",
      "type": "phrase",
      "stage": 5,
      "module": "s5.storytelling",
      "order": 5,
      "en": "Anyway, where was I?",
      "pl": "W każdym razie, na czym skończyłem?",
      "alternatives": [],
      "usage": "Wracasz do wątku.",
      "register": "neutral",
      "example": [
        {
          "en": "Sorry, I got distracted. Anyway, where was I?",
          "pl": "Sorry, rozproszyłem się. W każdym razie, na czym skończyłem?"
        }
      ],
      "tags": [
        "story"
      ],
      "level": "B1"
    },
    {
      "id": "s5.storytelling.so-funny",
      "type": "phrase",
      "stage": 5,
      "module": "s5.storytelling",
      "order": 6,
      "en": "It was so funny.",
      "pl": "To było takie śmieszne.",
      "alternatives": [
        "It was really funny.",
        "It was hilarious."
      ],
      "usage": "Komentarz do historii.",
      "register": "neutral",
      "example": [
        {
          "en": "He fell into the pool with his phone. It was so funny.",
          "pl": "Wpadł do basenu z telefonem. To było takie śmieszne."
        }
      ],
      "tags": [
        "story",
        "gr:past-simple"
      ],
      "level": "A2"
    },
    {
      "id": "s5.storytelling.couldnt-believe-it",
      "type": "phrase",
      "stage": 5,
      "module": "s5.storytelling",
      "order": 7,
      "en": "I couldn't believe it.",
      "pl": "Nie mogłem w to uwierzyć.",
      "alternatives": [
        "I couldn't believe my eyes."
      ],
      "usage": "Reakcja na zaskoczenie.",
      "register": "neutral",
      "example": [
        {
          "en": "He played my favourite track as the last one. I couldn't believe it.",
          "pl": "Zagrał mój ulubiony numer jako ostatni. Nie mogłem w to uwierzyć."
        }
      ],
      "tags": [
        "story",
        "gr:past-simple"
      ],
      "level": "A2"
    },
    {
      "id": "s5.storytelling.turned-out",
      "type": "phrase",
      "stage": 5,
      "module": "s5.storytelling",
      "order": 8,
      "en": "It turned out that he was from Poland too.",
      "pl": "Okazało się, że on też jest z Polski.",
      "alternatives": [
        "It turned out he was from Poland too.",
        "Turns out he was Polish too."
      ],
      "usage": "Zaskakujący zwrot akcji.",
      "register": "neutral",
      "example": [
        {
          "en": "We spoke English for an hour. It turned out that he was from Poland too!",
          "pl": "Gadaliśmy godzinę po angielsku. Okazało się, że on też jest z Polski!"
        }
      ],
      "tags": [
        "story"
      ],
      "level": "B1"
    },
    {
      "id": "s5.storytelling.at-first-nervous",
      "type": "phrase",
      "stage": 5,
      "module": "s5.storytelling",
      "order": 9,
      "en": "At first, I was nervous.",
      "pl": "Na początku się stresowałem.",
      "alternatives": [
        "At first I was a bit nervous."
      ],
      "usage": "Opowiadasz o uczuciach na początku.",
      "register": "neutral",
      "example": [
        {
          "en": "At first, I was nervous, but after ten minutes I felt fine.",
          "pl": "Na początku się stresowałem, ale po dziesięciu minutach było OK."
        }
      ],
      "tags": [
        "story",
        "gr:past-simple"
      ],
      "level": "A2"
    },
    {
      "id": "s5.storytelling.in-the-end-fine",
      "type": "phrase",
      "stage": 5,
      "module": "s5.storytelling",
      "order": 10,
      "en": "In the end, everything was fine.",
      "pl": "W końcu wszystko było dobrze.",
      "alternatives": [
        "In the end, it was all fine.",
        "Everything was fine in the end."
      ],
      "usage": "Szczęśliwe zakończenie.",
      "register": "neutral",
      "example": [
        {
          "en": "We lost our tent, but in the end, everything was fine.",
          "pl": "Zgubiliśmy namiot, ale w końcu wszystko było dobrze."
        }
      ],
      "note": "„In the end” = w końcu, ostatecznie. „At the end” = na końcu (czegoś): at the end of the set.",
      "tags": [
        "story",
        "polish-trap"
      ],
      "level": "A2"
    },
    {
      "id": "s5.storytelling.thats-when-realised",
      "type": "phrase",
      "stage": 5,
      "module": "s5.storytelling",
      "order": 11,
      "en": "That's when I realised my phone was gone.",
      "pl": "Wtedy zdałem sobie sprawę, że nie mam telefonu.",
      "alternatives": [],
      "usage": "Kulminacja historii.",
      "register": "neutral",
      "example": [
        {
          "en": "I put my hand in my pocket. That's when I realised my phone was gone.",
          "pl": "Włożyłem rękę do kieszeni. Wtedy zdałem sobie sprawę, że nie mam telefonu."
        }
      ],
      "tags": [
        "story",
        "uk-us"
      ],
      "level": "B1"
    },
    {
      "id": "s5.storytelling.what-happened-next",
      "type": "phrase",
      "stage": 5,
      "module": "s5.storytelling",
      "order": 12,
      "en": "What happened next?",
      "pl": "Co było dalej?",
      "alternatives": [
        "And then what happened?",
        "What happened then?"
      ],
      "usage": "Zachęcasz kogoś do opowiadania.",
      "register": "neutral",
      "example": [
        {
          "en": "And then the police came. — No way! What happened next?",
          "pl": "A potem przyjechała policja. — Serio? Co było dalej?"
        }
      ],
      "tags": [
        "story"
      ],
      "level": "A2"
    },
    {
      "id": "s5.storytelling.seriously-crazy",
      "type": "phrase",
      "stage": 5,
      "module": "s5.storytelling",
      "order": 13,
      "en": "Seriously, it was crazy.",
      "pl": "Serio, to było szalone.",
      "alternatives": [
        "Honestly, it was crazy.",
        "It was seriously crazy."
      ],
      "usage": "Podkreślasz emocje.",
      "register": "casual",
      "example": [
        {
          "en": "Thirty thousand people singing together. Seriously, it was crazy.",
          "pl": "Trzydzieści tysięcy ludzi śpiewa razem. Serio, to było szalone."
        }
      ],
      "tags": [
        "story"
      ],
      "level": "A2"
    },
    {
      "id": "s5.storytelling.long-story",
      "type": "phrase",
      "stage": 5,
      "module": "s5.storytelling",
      "order": 14,
      "en": "It's a long story.",
      "pl": "To długa historia.",
      "alternatives": [],
      "usage": "Gdy nie chcesz albo nie masz czasu opowiadać.",
      "register": "neutral",
      "example": [
        {
          "en": "Why are you wearing one shoe? — It's a long story.",
