    {
      "id": "s5.storytelling.was-when-rain",
      "type": "pattern",
      "stage": 5,
      "module": "s5.storytelling",
      "order": 25,
      "en": "I was ___ when it started raining.",
      "pl": "___, kiedy zaczęło padać.",
      "alternatives": [],
      "usage": "Tło akcji (Past Continuous) + nagłe wydarzenie (Past Simple).",
      "register": "neutral",
      "example": [
        {
          "en": "I was dancing when it started raining.",
          "pl": "Tańczyłem, kiedy zaczęło padać."
