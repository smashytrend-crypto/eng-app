    },
    {
      "id": "s7.phrasal-everyday.give-up",
      "type": "word",
      "stage": 7,
      "module": "s7.phrasal-everyday",
      "order": 19,
      "en": "give up",
      "pl": "poddać się; rzucić (nałóg)",
      "alternatives": [],
      "usage": "Przestać próbować albo zrezygnować.",
      "register": "neutral",
      "example": [
        {
          "en": "I gave up smoking two years ago.",
          "pl": "Rzuciłem palenie dwa lata temu."
        }
      ],
      "collocations": [
        "give up smoking",
        "don't give up",
        "give up on…"
      ],
      "note": "Rzucić coś = give up + rzeczownik albo -ing: give up smoking.",
      "tags": [
        "phrasal-verbs"
      ],
      "level": "A2"
    },
    {
      "id": "s7.phrasal-everyday.turn-up",
      "type": "word",
      "stage": 7,
      "module": "s7.phrasal-everyday",
      "order": 20,
      "en": "turn up",
      "pl": "pogłośnić; pojawić się",
      "alternatives": [],
      "usage": "Dwa znaczenia: głośność i przyjście.",
      "register": "neutral",
      "example": [
        {
          "en": "Only five people turned up.",
          "pl": "Pojawiło się tylko pięć osób."
        }
      ],
      "collocations": [
        "turn up the music",
        "turn up late",
        "didn't turn up"
      ],
      "tags": [
        "phrasal-verbs"
      ],
      "level": "B1"
    },
    {
      "id": "s7.phrasal-everyday.put-on",
      "type": "word",
      "stage": 7,
      "module": "s7.phrasal-everyday",
      "order": 21,
      "en": "put on",
      "pl": "założyć; nałożyć; włączyć",
      "alternatives": [],
      "usage": "Ubranie, krem, muzyka.",
      "register": "neutral",
      "example": [
        {
          "en": "Put on some sunscreen!",
          "pl": "Nałóż krem z filtrem!"
        }
      ],
      "collocations": [
        "put on a jacket",
        "put on sunscreen",
        "put on some music"
      ],
      "tags": [
        "phrasal-verbs"
      ],
      "level": "A2"
    },
    {
      "id": "s7.phrasal-everyday.take-off",
      "type": "word",
      "stage": 7,
      "module": "s7.phrasal-everyday",
      "order": 22,
      "en": "take off",
      "pl": "zdjąć; wystartować (samolot)",
      "alternatives": [],
      "usage": "Ubranie albo samolot.",
      "register": "neutral",
      "example": [
        {
          "en": "The plane took off two hours late.",
          "pl": "Samolot wystartował z dwugodzinnym opóźnieniem."
        }
      ],
      "collocations": [
        "take off your shoes",
        "the plane takes off",
        "take off a jacket"
      ],
      "tags": [
        "phrasal-verbs",
        "travel"
      ],
      "level": "A2"
    },
    {
      "id": "s7.phrasal-everyday.run-out-of",
      "type": "word",
      "stage": 7,
      "module": "s7.phrasal-everyday",
      "order": 23,
      "en": "run out of",
      "pl": "skończyć się (komuś coś)",
      "alternatives": [],
      "usage": "Brak zapasu.",
      "register": "neutral",
      "example": [
        {
          "en": "We ran out of money on the last day.",
          "pl": "Ostatniego dnia skończyły nam się pieniądze."
        }
      ],
      "collocations": [
        "run out of money",
        "run out of time",
        "run out of battery"
      ],
      "note": "Polskie „skończyło mi się…” → „I've run out of…” (to ja jestem podmiotem).",
      "tags": [
        "phrasal-verbs"
      ],
      "level": "A2"
    },
    {
      "id": "s7.phrasal-everyday.look-after",
      "type": "word",
      "stage": 7,
      "module": "s7.phrasal-everyday",
      "order": 24,
      "en": "look after",
      "pl": "opiekować się, pilnować",
      "alternatives": [],
      "usage": "Troska o kogoś lub coś.",
      "register": "neutral",
      "example": [
        {
          "en": "My mum looks after my cat when I'm away.",
          "pl": "Mama opiekuje się moim kotem, kiedy mnie nie ma."
        }
      ],
      "collocations": [
        "look after yourself",
        "look after kids",
        "look after my bag"
      ],
      "tags": [
        "phrasal-verbs",
        "gr:present-simple"
      ],
      "level": "A2"
    },
    {
      "id": "s7.phrasal-everyday.work-out",
      "type": "word",
      "stage": 7,
      "module": "s7.phrasal-everyday",
      "order": 25,
      "en": "work out",
      "pl": "trenować; rozwiązać, ogarnąć",
      "alternatives": [],
      "usage": "Siłownia albo rozwiązanie problemu.",
      "register": "neutral",
      "example": [
        {
          "en": "Don't worry, we'll work it out.",
          "pl": "Spokojnie, jakoś to rozwiążemy."
        }
      ],
      "collocations": [
