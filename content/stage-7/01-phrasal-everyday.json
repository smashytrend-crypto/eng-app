        "gym"
      ],
      "level": "A2"
    },
    {
      "id": "s7.phrasal-everyday.can-you-pick-up",
      "type": "pattern",
      "stage": 7,
      "module": "s7.phrasal-everyday",
      "order": 26,
      "en": "Can you pick up ___?",
      "pl": "Możesz kupić / odebrać ___?",
      "alternatives": [],
      "usage": "Prośba po drodze.",
      "register": "neutral",
      "example": [
        {
          "en": "Can you pick up some beers on the way?",
          "pl": "Możesz po drodze kupić piwo?"
        },
        {
          "en": "Can you pick up my package?",
          "pl": "Możesz odebrać moją paczkę?"
        }
      ],
      "tags": [
        "phrasal-verbs"
      ],
      "level": "A2"
    },
    {
      "id": "s7.phrasal-everyday.need-to-find-out",
      "type": "pattern",
      "stage": 7,
      "module": "s7.phrasal-everyday",
      "order": 27,
      "en": "I need to find out ___.",
      "pl": "Muszę się dowiedzieć, ___.",
      "alternatives": [],
      "usage": "Pytanie pośrednie po „find out”.",
      "register": "neutral",
      "example": [
        {
          "en": "I need to find out what time it starts.",
          "pl": "Muszę się dowiedzieć, o której się zaczyna."
        },
        {
          "en": "I need to find out where the hotel is.",
          "pl": "Muszę się dowiedzieć, gdzie jest hotel."
        }
      ],
      "note": "Po „find out” szyk zdania oznajmującego: where the hotel IS (nie „where is the hotel”).",
      "tags": [
        "phrasal-verbs",
        "polish-trap"
      ],
      "level": "B1"
    },
    {
