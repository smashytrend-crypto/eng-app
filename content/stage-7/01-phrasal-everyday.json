{
  "module": {
    "id": "s7.phrasal-everyday",
    "stage": 7,
    "order": 1,
    "title": "Phrasal verbs: codzienne",
    "titleEn": "Everyday phrasal verbs",
    "description": "Najczęstsze czasowniki złożone: pick up, find out, give up, put on, take off, run out of, look after, work out…",
    "tags": [
      "general"
    ]
  },
  "items": [
    {
      "id": "s7.phrasal-everyday.pick-me-up",
      "type": "phrase",
      "stage": 7,
      "module": "s7.phrasal-everyday",
      "order": 1,
      "en": "Can you pick me up at the station?",
      "pl": "Możesz mnie odebrać z dworca?",
      "alternatives": [
        "Could you pick me up at the station?",
        "Can you pick me up from the station?"
      ],
      "usage": "Prosisz, żeby ktoś po ciebie przyjechał.",
      "register": "neutral",
      "example": [
        {
          "en": "Can you pick me up at the station? My train arrives at eight.",
          "pl": "Możesz mnie odebrać z dworca? Pociąg przyjeżdża o ósmej."
        }
      ],
      "tags": [
        "phrasal-verbs"
      ],
      "level": "A2"
    },
    {
      "id": "s7.phrasal-everyday.find-out-let-know",
      "type": "phrase",
      "stage": 7,
      "module": "s7.phrasal-everyday",
      "order": 2,
      "en": "I'll find out and let you know.",
      "pl": "Dowiem się i dam ci znać.",
      "alternatives": [
        "I'll check and let you know."
      ],
      "usage": "„Find out” = dowiedzieć się.",
      "register": "neutral",
      "example": [
        {
          "en": "What time does it start? — Not sure. I'll find out and let you know.",
          "pl": "O której się zaczyna? — Nie wiem. Dowiem się i dam ci znać."
        }
      ],
      "tags": [
        "phrasal-verbs"
      ],
      "level": "A2"
    },
    {
      "id": "s7.phrasal-everyday.dont-give-up",
      "type": "phrase",
      "stage": 7,
      "module": "s7.phrasal-everyday",
      "order": 3,
      "en": "Don't give up!",
      "pl": "Nie poddawaj się!",
      "alternatives": [
        "Never give up!"
      ],
      "usage": "Motywacja — w nauce, na siłowni.",
      "register": "neutral",
      "example": [
        {
          "en": "My English is still bad. — Don't give up! You're getting better.",
          "pl": "Mój angielski wciąż jest słaby. — Nie poddawaj się! Robisz postępy."
        }
      ],
      "tags": [
        "phrasal-verbs"
      ],
      "level": "A2"
    },
    {
      "id": "s7.phrasal-everyday.turn-it-down",
      "type": "phrase",
      "stage": 7,
      "module": "s7.phrasal-everyday",
      "order": 4,
      "en": "Turn it down, please — it's too loud.",
      "pl": "Ścisz, proszę — za głośno.",
      "alternatives": [
        "Can you turn it down, please?",
        "Turn it down a bit, please."
      ],
      "usage": "Prosisz o ściszenie.",
      "register": "neutral",
      "example": [
        {
          "en": "Turn it down, please — it's too loud. The neighbours!",
          "pl": "Ścisz, proszę — za głośno. Sąsiedzi!"
        }
      ],
      "tags": [
        "phrasal-verbs"
      ],
      "level": "A2"
    },
    {
      "id": "s7.phrasal-everyday.put-jacket-on",
      "type": "phrase",
      "stage": 7,
      "module": "s7.phrasal-everyday",
      "order": 5,
      "en": "Put your jacket on — it's cold.",
      "pl": "Załóż kurtkę — zimno.",
      "alternatives": [
        "Put on your jacket — it's cold."
      ],
      "usage": "„Put on” = założyć (ubranie).",
      "register": "neutral",
      "example": [
        {
          "en": "Put your jacket on — it's cold at night.",
          "pl": "Załóż kurtkę — w nocy jest zimno."
        }
      ],
      "note": "Put on = założyć, take off = zdjąć.",
      "tags": [
        "phrasal-verbs"
      ],
      "level": "A2"
    },
    {
      "id": "s7.phrasal-everyday.take-shoes-off",
      "type": "phrase",
      "stage": 7,
      "module": "s7.phrasal-everyday",
      "order": 6,
      "en": "Take your shoes off, please.",
      "pl": "Zdejmij buty, proszę.",
      "alternatives": [
        "Please take your shoes off.",
        "Can you take your shoes off?"
      ],
      "usage": "U kogoś w domu.",
      "register": "neutral",
      "example": [
        {
          "en": "Come in! Take your shoes off, please.",
          "pl": "Wejdź! Zdejmij buty, proszę."
        }
      ],
      "tags": [
        "phrasal-verbs",
        "home"
      ],
      "level": "A2"
    },
    {
      "id": "s7.phrasal-everyday.run-out-of-water",
      "type": "phrase",
      "stage": 7,
      "module": "s7.phrasal-everyday",
      "order": 7,
      "en": "We've run out of water.",
      "pl": "Skończyła nam się woda.",
      "alternatives": [
        "We've got no water left.",
        "We ran out of water."
      ],
      "usage": "„Run out of” = wyczerpać zapas.",
      "register": "neutral",
      "example": [
        {
          "en": "We've run out of water. Can you get some?",
          "pl": "Skończyła nam się woda. Skoczysz po wodę?"
        }
      ],
      "tags": [
        "phrasal-verbs"
      ],
      "level": "A2"
    },
    {
      "id": "s7.phrasal-everyday.look-after-bag",
      "type": "phrase",
      "stage": 7,
      "module": "s7.phrasal-everyday",
      "order": 8,
      "en": "Can you look after my bag for a minute?",
      "pl": "Możesz przypilnować mojej torby przez chwilę?",
      "alternatives": [
        "Can you watch my bag for a minute?",
        "Could you look after my bag for a minute?"
      ],
      "usage": "„Look after” = opiekować się, pilnować.",
      "register": "neutral",
      "example": [
        {
          "en": "Can you look after my bag for a minute? I need the toilet.",
          "pl": "Przypilnujesz mojej torby przez chwilę? Muszę do toalety."
        }
      ],
      "tags": [
        "phrasal-verbs"
      ],
      "level": "A2"
    },
    {
      "id": "s7.phrasal-everyday.how-turn-out",
      "type": "phrase",
      "stage": 7,
      "module": "s7.phrasal-everyday",
      "order": 9,
      "en": "How did it turn out?",
      "pl": "Jak to wyszło?",
      "alternatives": [
        "How did it go?"
      ],
      "usage": "Pytasz o wynik.",
      "register": "neutral",
      "example": [
        {
          "en": "You had a job interview yesterday! How did it turn out?",
          "pl": "Miałeś wczoraj rozmowę o pracę! Jak wyszło?"
        }
      ],
      "tags": [
        "phrasal-verbs"
      ],
      "level": "B1"
    },
    {
      "id": "s7.phrasal-everyday.work-out-later",
      "type": "phrase",
      "stage": 7,
      "module": "s7.phrasal-everyday",
      "order": 10,
      "en": "I'm going to work out later.",
      "pl": "Później idę poćwiczyć.",
      "alternatives": [
        "I'm going to the gym later.",
        "I'm working out later."
      ],
      "usage": "„Work out” = trenować (i też: rozwiązać problem).",
      "register": "neutral",
      "example": [
        {
          "en": "I'm going to work out later. Want to come?",
          "pl": "Później idę poćwiczyć. Idziesz?"
        }
      ],
      "tags": [
        "phrasal-verbs",
        "gym",
        "gr:going-to"
      ],
      "level": "A2"
    },
    {
      "id": "s7.phrasal-everyday.hurry-up",
      "type": "phrase",
      "stage": 7,
      "module": "s7.phrasal-everyday",
      "order": 11,
      "en": "Hurry up! We're late.",
      "pl": "Pospiesz się! Jesteśmy spóźnieni.",
      "alternatives": [
        "Come on, hurry up! We're late."
      ],
      "usage": "Poganiasz kogoś.",
      "register": "neutral",
      "example": [
        {
          "en": "Hurry up! We're late for the first set.",
          "pl": "Pospiesz się! Spóźnimy się na pierwszy set."
        }
      ],
      "tags": [
        "phrasal-verbs"
      ],
      "level": "A2"
    },
    {
      "id": "s7.phrasal-everyday.calm-down",
      "type": "phrase",
      "stage": 7,
      "module": "s7.phrasal-everyday",
      "order": 12,
      "en": "Calm down, it's fine.",
      "pl": "Uspokój się, wszystko gra.",
      "alternatives": [
        "Relax, it's fine.",
        "Calm down, it's OK."
      ],
      "usage": "Uspokajasz kogoś.",
      "register": "neutral",
      "example": [
        {
          "en": "I can't find my ticket! — Calm down, it's fine. It's in your phone.",
          "pl": "Nie mogę znaleźć biletu! — Spokojnie, wszystko gra. Masz go w telefonie."
        }
      ],
      "tags": [
        "phrasal-verbs"
      ],
      "level": "A2"
    },
    {
      "id": "s7.phrasal-everyday.come-on-lets-go",
      "type": "phrase",
      "stage": 7,
      "module": "s7.phrasal-everyday",
      "order": 13,
      "en": "Come on, let's go!",
      "pl": "No chodź, idziemy!",
      "alternatives": [],
      "usage": "Zachęcasz do ruszenia się.",
      "register": "casual",
      "example": [
        {
          "en": "Come on, let's go! The show is starting!",
          "pl": "No chodź, idziemy! Show się zaczyna!"
        }
      ],
      "tags": [
        "phrasal-verbs"
      ],
      "level": "A2"
    },
    {
      "id": "s7.phrasal-everyday.hold-on-phone",
      "type": "phrase",
      "stage": 7,
      "module": "s7.phrasal-everyday",
      "order": 14,
      "en": "Hold on, where's my phone?",
      "pl": "Czekaj, gdzie mój telefon?",
      "alternatives": [
        "Wait, where's my phone?",
        "Hang on, where's my phone?"
      ],
      "usage": "„Hold on” = czekaj chwilę.",
      "register": "casual",
      "example": [
        {
          "en": "Hold on, where's my phone? — In your hand!",
          "pl": "Czekaj, gdzie mój telefon? — W ręce!"
        }
      ],
      "tags": [
        "phrasal-verbs"
      ],
      "level": "A2"
    },
    {
      "id": "s7.phrasal-everyday.pay-you-back",
      "type": "phrase",
      "stage": 7,
      "module": "s7.phrasal-everyday",
      "order": 15,
      "en": "I'll pay you back.",
      "pl": "Oddam ci (pieniądze).",
      "alternatives": [
        "I'll give you the money back."
      ],
      "usage": "„Pay back” = oddać pieniądze.",
      "register": "neutral",
      "example": [
        {
          "en": "Can you lend me twenty euros? I'll pay you back tomorrow.",
          "pl": "Pożyczysz mi dwadzieścia euro? Oddam jutro."
        }
      ],
      "tags": [
        "phrasal-verbs",
        "numbers"
      ],
      "level": "A2"
    },
    {
      "id": "s7.phrasal-everyday.wake-up",
      "type": "word",
      "stage": 7,
      "module": "s7.phrasal-everyday",
      "order": 16,
      "en": "wake up",
      "pl": "obudzić się",
      "alternatives": [],
      "usage": "Koniec snu.",
      "register": "neutral",
      "example": [
        {
          "en": "I woke up at noon after the party.",
          "pl": "Po imprezie obudziłem się w południe."
        }
      ],
      "collocations": [
        "wake up early",
        "wake someone up",
        "wake-up call"
      ],
      "note": "Wake up = obudzić się. Get up = wstać z łóżka.",
      "tags": [
        "phrasal-verbs"
      ],
      "level": "A2"
    },
    {
      "id": "s7.phrasal-everyday.pick-up",
      "type": "word",
      "stage": 7,
      "module": "s7.phrasal-everyday",
      "order": 17,
      "en": "pick up",
      "pl": "odebrać; podnieść; kupić po drodze",
      "alternatives": [],
      "usage": "Bardzo częsty phrasal verb.",
      "register": "neutral",
      "example": [
        {
          "en": "I'll pick up some snacks on the way.",
          "pl": "Kupię po drodze jakieś przekąski."
        }
      ],
      "collocations": [
        "pick someone up",
        "pick up the phone",
        "pick up some food"
      ],
      "tags": [
        "phrasal-verbs"
      ],
      "level": "A2"
    },
    {
      "id": "s7.phrasal-everyday.find-out",
      "type": "word",
      "stage": 7,
      "module": "s7.phrasal-everyday",
      "order": 18,
      "en": "find out",
      "pl": "dowiedzieć się",
      "alternatives": [],
      "usage": "Zdobyć informację.",
      "register": "neutral",
      "example": [
        {
          "en": "I found out that the show was cancelled.",
          "pl": "Dowiedziałem się, że show odwołano."
        }
      ],
      "collocations": [
        "find out about…",
        "find out what…",
        "find out the truth"
      ],
      "tags": [
        "phrasal-verbs"
      ],
