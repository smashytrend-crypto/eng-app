      "type": "pattern",
      "stage": 7,
      "module": "s7.phrasal-everyday",
      "order": 29,
      "en": "We ran out of ___.",
      "pl": "Skończył / skończyła nam się ___.",
      "alternatives": [],
      "usage": "Czego zabrakło.",
      "register": "neutral",
      "example": [
