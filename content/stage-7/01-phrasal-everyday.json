      "type": "pattern",
      "stage": 7,
      "module": "s7.phrasal-everyday",
      "order": 28,
      "en": "I gave up ___.",
      "pl": "Rzuciłem ___.",
      "alternatives": [],
      "usage": "Z czego zrezygnowałeś.",
      "register": "neutral",
      "example": [
        {
          "en": "I gave up smoking.",
          "pl": "Rzuciłem palenie."
        },
        {
          "en": "I gave up sugar for a month.",
          "pl": "Na miesiąc rzuciłem cukier."
        }
      ],
      "tags": [
        "phrasal-verbs",
        "gr:past-simple"
      ],
      "level": "A2"
    },
