    {
      "id": "s7.phrasal-people.meet-up-sometime",
      "type": "phrase",
      "stage": 7,
      "module": "s7.phrasal-people",
      "order": 1,
      "en": "Let's meet up sometime!",
      "pl": "Spotkajmy się kiedyś!",
      "alternatives": [
        "We should meet up sometime!",
        "Let's meet up soon!"
      ],
      "usage": "„Meet up” = umówić się na spotkanie.",
      "register": "neutral",
      "example": [
        {
          "en": "It was great to see you. Let's meet up sometime!",
          "pl": "Super było cię zobaczyć. Spotkajmy się kiedyś!"
        }
