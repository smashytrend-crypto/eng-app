  "items": [
    {
      "id": "s7.meeting-people.where-you-guys-from",
      "type": "phrase",
      "stage": 7,
      "module": "s7.meeting-people",
      "order": 1,
      "en": "Where are you guys from?",
      "pl": "Skąd jesteście?",
      "alternatives": [
        "Where are you all from?",
        "Hey, where are you guys from?"
      ],
      "usage": "Zagadujesz grupę na festiwalu.",
      "register": "casual",
      "example": [
        {
          "en": "Hey! Where are you guys from? — Brazil! And you?",
          "pl": "Hej! Skąd jesteście? — Z Brazylii! A ty?"
        }
      ],
      "tags": [
        "festival",
        "smalltalk"
      ],
      "level": "A2"
    },
    {
