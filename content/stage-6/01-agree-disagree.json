      "tags": [
        "opinions"
      ],
      "level": "B1"
    },
    {
      "id": "s6.agree-disagree.not-true",
      "type": "phrase",
      "stage": 6,
      "module": "s6.agree-disagree",
      "order": 15,
      "en": "No way, that's not true!",
