{
  "module": {
    "id": "s6.agree-disagree",
    "stage": 6,
    "order": 1,
    "title": "Zgadzam się, nie zgadzam się",
    "titleEn": "Agreeing & disagreeing",
    "description": "Jak się zgadzać, grzecznie nie zgadzać i kończyć spór: You're right, Fair enough, I see what you mean, but…",
    "tags": [
      "general"
    ]
  },
  "items": [
    {
      "id": "s6.agree-disagree.totally-agree",
      "type": "phrase",
      "stage": 6,
      "module": "s6.agree-disagree",
      "order": 1,
      "en": "I totally agree.",
      "pl": "Całkowicie się zgadzam.",
      "alternatives": [
        "I completely agree.",
        "I couldn't agree more.",
        "I totally agree with you."
      ],
      "usage": "Mocne „zgadzam się”.",
      "register": "neutral",
      "example": [
        {
          "en": "Berlin has the best clubs in Europe. — I totally agree.",
          "pl": "Berlin ma najlepsze kluby w Europie. — Całkowicie się zgadzam."
        }
      ],
      "tags": [
        "opinions"
      ],
      "level": "A2"
    },
    {
      "id": "s6.agree-disagree.not-sure-about-that",
      "type": "phrase",
      "stage": 6,
      "module": "s6.agree-disagree",
      "order": 2,
      "en": "I'm not sure about that.",
      "pl": "Nie jestem tego pewien.",
      "alternatives": [
        "I'm not so sure about that."
      ],
      "usage": "Delikatna niezgoda.",
      "register": "neutral",
      "example": [
        {
          "en": "Techno is just noise. — Hmm, I'm not sure about that.",
          "pl": "Techno to tylko hałas. — Hmm, nie byłbym tego taki pewien."
        }
      ],
      "tags": [
        "opinions"
      ],
      "level": "A2"
    },
    {
      "id": "s6.agree-disagree.see-what-you-mean",
      "type": "phrase",
      "stage": 6,
      "module": "s6.agree-disagree",
      "order": 3,
      "en": "I see what you mean, but…",
      "pl": "Rozumiem, o co ci chodzi, ale…",
      "alternatives": [
        "I know what you mean, but…",
        "I see your point, but…"
      ],
      "usage": "Grzeczna niezgoda — najpierw doceniasz zdanie rozmówcy.",
      "register": "neutral",
      "example": [
        {
          "en": "I see what you mean, but the tickets are really expensive.",
          "pl": "Rozumiem, o co ci chodzi, ale bilety są naprawdę drogie."
        }
      ],
      "tags": [
        "opinions"
      ],
      "level": "B1"
    },
    {
      "id": "s6.agree-disagree.thats-true",
      "type": "phrase",
      "stage": 6,
      "module": "s6.agree-disagree",
      "order": 4,
      "en": "That's true.",
      "pl": "To prawda.",
      "alternatives": [
        "True.",
        "That's so true."
      ],
      "usage": "Zgadzasz się z faktem.",
      "register": "neutral",
      "example": [
        {
          "en": "It's always busy on Fridays. — That's true.",
          "pl": "W piątki zawsze jest tłok. — To prawda."
        }
      ],
      "tags": [
        "opinions"
      ],
      "level": "A2"
    },
    {
      "id": "s6.agree-disagree.dont-think-so",
      "type": "phrase",
      "stage": 6,
      "module": "s6.agree-disagree",
      "order": 5,
      "en": "I don't think so.",
      "pl": "Nie sądzę.",
      "alternatives": [],
      "usage": "Niezgoda albo zaprzeczenie.",
      "register": "neutral",
      "example": [
        {
          "en": "Is it going to rain? — I don't think so.",
          "pl": "Będzie padać? — Nie sądzę."
        }
      ],
      "note": "Po angielsku przeczenie idzie do „think”: I don't think it's true (a nie „I think it isn't true”).",
      "tags": [
        "opinions",
        "polish-trap"
      ],
      "level": "A2"
    },
    {
      "id": "s6.agree-disagree.youre-right",
      "type": "phrase",
      "stage": 6,
      "module": "s6.agree-disagree",
      "order": 6,
      "en": "You're right.",
      "pl": "Masz rację.",
      "alternatives": [
        "You're totally right.",
        "You're absolutely right."
      ],
      "usage": "Przyznajesz komuś rację.",
      "register": "neutral",
      "example": [
        {
          "en": "We should leave now or we'll miss the train. — You're right.",
          "pl": "Powinniśmy już iść, bo ucieknie nam pociąg. — Masz rację."
        }
      ],
      "note": "Polska pułapka: NIE „You have right”. Racja to „be right”: you're right, I was wrong.",
      "tags": [
        "opinions",
        "polish-trap"
      ],
      "level": "A2"
    },
    {
      "id": "s6.agree-disagree.fair-enough",
      "type": "phrase",
      "stage": 6,
      "module": "s6.agree-disagree",
      "order": 7,
      "en": "Fair enough.",
      "pl": "No dobra, rozumiem.",
      "alternatives": [],
      "usage": "Akceptujesz argument — bardzo brytyjskie.",
      "register": "casual",
      "example": [
        {
          "en": "I can't come, I'm working early tomorrow. — Fair enough.",
          "pl": "Nie dam rady, jutro wcześnie pracuję. — No dobra, rozumiem."
        }
      ],
      "tags": [
        "opinions",
        "uk-us"
      ],
      "level": "B1"
    },
    {
      "id": "s6.agree-disagree.exactly",
      "type": "phrase",
      "stage": 6,
      "module": "s6.agree-disagree",
      "order": 8,
      "en": "Exactly!",
      "pl": "Dokładnie!",
      "alternatives": [
        "Absolutely!"
      ],
      "usage": "Pełna zgoda.",
      "register": "neutral",
      "example": [
        {
          "en": "So we need to leave at seven. — Exactly!",
          "pl": "Czyli musimy wyjść o siódmej. — Dokładnie!"
        }
      ],
      "tags": [
        "opinions"
      ],
      "level": "A2"
    },
    {
      "id": "s6.agree-disagree.disagree-actually",
      "type": "phrase",
      "stage": 6,
      "module": "s6.agree-disagree",
      "order": 9,
      "en": "I disagree, actually.",
      "pl": "Właściwie się nie zgadzam.",
      "alternatives": [
        "Actually, I disagree.",
        "I don't agree, actually."
      ],
      "usage": "Uprzejma, ale jasna niezgoda.",
      "register": "neutral",
      "example": [
        {
          "en": "Commercial EDM is the best. — I disagree, actually.",
          "pl": "Komercyjny EDM jest najlepszy. — Właściwie się nie zgadzam."
        }
      ],
      "tags": [
        "opinions"
      ],
      "level": "A2"
    },
    {
      "id": "s6.agree-disagree.me-neither",
      "type": "phrase",
      "stage": 6,
      "module": "s6.agree-disagree",
      "order": 10,
      "en": "Me neither.",
      "pl": "Ja też nie.",
      "alternatives": [
        "Neither do I.",
        "Me either."
      ],
      "usage": "Zgadzasz się z przeczeniem.",
      "register": "neutral",
      "example": [
        {
          "en": "I don't like long queues. — Me neither.",
          "pl": "Nie lubię długich kolejek. — Ja też nie."
        }
      ],
      "note": "Na przeczenie odpowiadasz „Me neither”, nie „Me too”.",
      "tags": [
        "opinions",
        "polish-trap"
      ],
      "level": "A2"
    },
    {
      "id": "s6.agree-disagree.so-do-i",
      "type": "phrase",
      "stage": 6,
      "module": "s6.agree-disagree",
      "order": 11,
      "en": "So do I.",
      "pl": "Ja też.",
      "alternatives": [
        "Me too.",
        "Same here."
      ],
      "usage": "Bardziej eleganckie „me too”.",
      "register": "neutral",
      "example": [
        {
          "en": "I love melodic techno. — So do I!",
          "pl": "Uwielbiam melodic techno. — Ja też!"
        }
      ],
      "tags": [
        "opinions"
      ],
      "level": "B1"
    },
    {
      "id": "s6.agree-disagree.agree-to-disagree",
      "type": "phrase",
      "stage": 6,
      "module": "s6.agree-disagree",
      "order": 12,
      "en": "Let's agree to disagree.",
      "pl": "Zostańmy przy swoich zdaniach.",
      "alternatives": [],
      "usage": "Kończysz spór pokojowo.",
      "register": "neutral",
      "example": [
        {
          "en": "You'll never convince me. — OK, let's agree to disagree.",
          "pl": "Nigdy mnie nie przekonasz. — OK, zostańmy przy swoich zdaniach."
        }
      ],
      "tags": [
        "opinions"
      ],
      "level": "B1"
    },
    {
      "id": "s6.agree-disagree.maybe-youre-right",
      "type": "phrase",
      "stage": 6,
      "module": "s6.agree-disagree",
      "order": 13,
      "en": "Maybe you're right.",
      "pl": "Może masz rację.",
      "alternatives": [
