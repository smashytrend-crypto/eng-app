      ],
      "note": "X razy droższe = „twice / three times AS expensive AS”.",
      "tags": [
        "comparisons",
        "numbers"
      ],
      "level": "B1"
    },
    {
      "id": "s6.comparisons.less-crowded",
      "type": "phrase",
      "stage": 6,
      "module": "s6.comparisons",
      "order": 15,
      "en": "It's less crowded in the morning.",
      "pl": "Rano jest mniej tłoczno.",
