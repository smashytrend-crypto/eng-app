      "en": "better",
      "pl": "lepszy, lepiej",
      "alternatives": [],
      "usage": "Stopień wyższy od „good / well”.",
      "register": "neutral",
      "example": [
        {
          "en": "I feel better today.",
          "pl": "Dziś czuję się lepiej."
