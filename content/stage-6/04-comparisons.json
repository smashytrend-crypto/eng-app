      "tags": [
        "comparisons"
      ],
      "level": "A2"
    },
    {
      "id": "s6.comparisons.worse",
      "type": "word",
      "stage": 6,
      "module": "s6.comparisons",
      "order": 17,
      "en": "worse",
      "pl": "gorszy, gorzej",
      "alternatives": [],
      "usage": "Stopień wyższy od „bad”.",
      "register": "neutral",
      "example": [
        {
          "en": "The weather is worse than yesterday.",
