      "stage": 6,
      "module": "s6.comparisons",
      "order": 20,
      "en": "prefer",
      "pl": "woleć",
      "alternatives": [],
      "usage": "Wybór między opcjami.",
      "register": "neutral",
      "example": [
        {
          "en": "I prefer trains to planes.",
          "pl": "Wolę pociągi od samolotów."
