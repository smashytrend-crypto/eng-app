{
  "module": {
    "id": "s6.comparisons",
    "stage": 6,
    "order": 4,
    "title": "Porównania",
    "titleEn": "Comparisons",
    "description": "Lepszy, gorszy, najlepszy, taki sam, nie tak dobry jak, dwa razy droższy — porównywanie miejsc, cen, muzyki i festiwali.",
    "tags": [
      "general"
    ]
  },
  "items": [
    {
      "id": "s6.comparisons.better-than-last-year",
      "type": "phrase",
      "stage": 6,
      "module": "s6.comparisons",
      "order": 1,
      "en": "It's much better than last year.",
      "pl": "Jest dużo lepiej niż w zeszłym roku.",
      "alternatives": [
        "It's way better than last year.",
        "It's a lot better than last year."
      ],
      "usage": "Porównanie z przeszłością.",
      "register": "neutral",
      "example": [
        {
          "en": "The new main stage? It's much better than last year.",
          "pl": "Nowa główna scena? Dużo lepsza niż w zeszłym roku."
        }
      ],
      "tags": [
        "comparisons"
      ],
      "level": "A2"
    },
    {
      "id": "s6.comparisons.not-as-good-original",
      "type": "phrase",
      "stage": 6,
      "module": "s6.comparisons",
      "order": 2,
      "en": "It's not as good as the original.",
      "pl": "Nie jest tak dobre jak oryginał.",
      "alternatives": [],
      "usage": "O remiksie, filmie, sequelu.",
      "register": "neutral",
      "example": [
        {
          "en": "Have you heard the remix? — Yeah, but it's not as good as the original.",
          "pl": "Słyszałeś remix? — Tak, ale nie jest tak dobry jak oryginał."
        }
      ],
      "tags": [
        "comparisons",
        "music"
      ],
      "level": "A2"
    },
    {
      "id": "s6.comparisons.biggest-festival",
      "type": "phrase",
      "stage": 6,
      "module": "s6.comparisons",
      "order": 3,
      "en": "This is the biggest festival in the world.",
      "pl": "To największy festiwal na świecie.",
      "alternatives": [
        "It's the biggest festival in the world."
      ],
      "usage": "Stopień najwyższy.",
      "register": "neutral",
      "example": [
        {
          "en": "Is Tomorrowland really the biggest festival in the world? — One of them!",
          "pl": "Tomorrowland to naprawdę największy festiwal na świecie? — Jeden z nich!"
        }
      ],
      "note": "Najwyższy stopień z „the”: the biggest, the best, the most expensive.",
      "tags": [
        "comparisons",
        "festival",
        "gr:articles"
      ],
      "level": "A2"
    },
    {
      "id": "s6.comparisons.beer-more-expensive",
      "type": "phrase",
      "stage": 6,
      "module": "s6.comparisons",
      "order": 4,
      "en": "Beer is more expensive here than in Poland.",
      "pl": "Piwo jest tu droższe niż w Polsce.",
      "alternatives": [
        "Beer here is more expensive than in Poland."
      ],
      "usage": "Porównanie cen.",
      "register": "neutral",
      "example": [
        {
          "en": "Beer is more expensive here than in Poland — almost three times!",
          "pl": "Piwo jest tu droższe niż w Polsce — prawie trzy razy!"
        }
      ],
      "note": "Długie przymiotniki: more + przymiotnik + than (more expensive than).",
      "tags": [
        "comparisons",
        "numbers"
      ],
      "level": "A2"
    },
    {
      "id": "s6.comparisons.pretty-similar",
      "type": "phrase",
      "stage": 6,
      "module": "s6.comparisons",
      "order": 5,
      "en": "They're pretty similar.",
      "pl": "Są dość podobne.",
      "alternatives": [
        "They're quite similar."
      ],
      "usage": "Mała różnica.",
      "register": "neutral",
      "example": [
        {
          "en": "Tech house or techno? They're pretty similar, but tech house is more groovy.",
          "pl": "Tech house czy techno? Są dość podobne, ale tech house bardziej buja."
        }
      ],
      "tags": [
        "comparisons"
      ],
      "level": "A2"
    },
    {
      "id": "s6.comparisons.same-as-last-time",
      "type": "phrase",
      "stage": 6,
      "module": "s6.comparisons",
      "order": 6,
      "en": "It's the same as last time.",
      "pl": "Jest tak samo jak ostatnio.",
      "alternatives": [
        "It's the same as last year."
      ],
      "usage": "Brak różnicy.",
      "register": "neutral",
      "example": [
        {
          "en": "Is the campsite different this year? — No, it's the same as last time.",
          "pl": "Pole namiotowe jest w tym roku inne? — Nie, tak samo jak ostatnio."
        }
      ],
      "note": "„Taki sam JAK” = „the same AS” (nie „the same like”).",
      "tags": [
        "comparisons",
        "polish-trap"
      ],
      "level": "A2"
    },
    {
      "id": "s6.comparisons.bigger-than-thought",
      "type": "phrase",
      "stage": 6,
      "module": "s6.comparisons",
      "order": 7,
      "en": "It's a lot bigger than I thought.",
      "pl": "Jest dużo większe, niż myślałem.",
      "alternatives": [
        "It's much bigger than I thought."
      ],
      "usage": "Zaskoczenie rozmiarem.",
      "register": "neutral",
      "example": [
        {
          "en": "Wow, the festival area is a lot bigger than I thought.",
          "pl": "Wow, teren festiwalu jest dużo większy, niż myślałem."
        }
      ],
      "tags": [
        "comparisons"
      ],
      "level": "B1"
    },
    {
      "id": "s6.comparisons.which-prefer",
      "type": "phrase",
      "stage": 6,
      "module": "s6.comparisons",
      "order": 8,
      "en": "Which one do you prefer?",
      "pl": "Który wolisz?",
      "alternatives": [
        "Which do you prefer?",
        "Which one do you like more?"
      ],
      "usage": "Pytasz o preferencje.",
      "register": "neutral",
      "example": [
        {
          "en": "House or techno — which one do you prefer?",
          "pl": "House czy techno — co wolisz?"
        }
      ],
      "tags": [
        "comparisons",
        "gr:questions-do"
      ],
      "level": "A2"
    },
    {
      "id": "s6.comparisons.neither-of-them",
      "type": "phrase",
      "stage": 6,
      "module": "s6.comparisons",
      "order": 9,
      "en": "Neither of them.",
      "pl": "Żaden z nich.",
      "alternatives": [],
      "usage": "Odrzucasz obie opcje.",
      "register": "neutral",
      "example": [
        {
          "en": "Do you like Coldplay or U2? — Neither of them, to be honest.",
          "pl": "Lubisz Coldplay czy U2? — Szczerze, żadnego."
        }
      ],
      "tags": [
        "comparisons"
      ],
      "level": "B1"
    },
    {
      "id": "s6.comparisons.both-are-good",
      "type": "phrase",
      "stage": 6,
      "module": "s6.comparisons",
      "order": 10,
      "en": "Both are good.",
      "pl": "Oba są dobre.",
      "alternatives": [
        "They're both good."
      ],
      "usage": "Nie chcesz wybierać.",
      "register": "neutral",
      "example": [
        {
          "en": "Pizza or burger? — Both are good. You choose.",
          "pl": "Pizza czy burger? — Oba dobre. Ty wybierz."
        }
      ],
      "tags": [
        "comparisons"
      ],
      "level": "A2"
    },
    {
      "id": "s6.comparisons.better-and-better",
      "type": "phrase",
      "stage": 6,
      "module": "s6.comparisons",
      "order": 11,
      "en": "It's getting better and better.",
      "pl": "Jest coraz lepiej.",
      "alternatives": [
        "It's getting better."
      ],
      "usage": "Postęp w czasie.",
      "register": "neutral",
      "example": [
        {
          "en": "How's your English? — It's getting better and better!",
          "pl": "Jak twój angielski? — Coraz lepiej!"
        }
      ],
      "note": "„Coraz lepiej” = „better and better”. „Coraz drożej” = „more and more expensive”.",
      "tags": [
        "comparisons"
      ],
      "level": "B1"
    },
    {
      "id": "s6.comparisons.the-more-the-better",
      "type": "phrase",
      "stage": 6,
      "module": "s6.comparisons",
      "order": 12,
      "en": "The more, the better.",
      "pl": "Im więcej, tym lepiej.",
      "alternatives": [
        "The more the merrier."
      ],
      "usage": "Zapraszasz więcej osób.",
      "register": "neutral",
      "example": [
        {
          "en": "Can I bring two friends? — Sure, the more, the better!",
          "pl": "Mogę wziąć dwóch kumpli? — Jasne, im więcej, tym lepiej!"
        }
      ],
      "tags": [
        "comparisons"
      ],
      "level": "B1"
    },
    {
      "id": "s6.comparisons.nothing-compares",
      "type": "phrase",
      "stage": 6,
      "module": "s6.comparisons",
      "order": 13,
      "en": "Nothing compares to Tomorrowland.",
      "pl": "Nic nie dorówna Tomorrowland.",
      "alternatives": [
        "Nothing beats Tomorrowland."
      ],
      "usage": "Najwyższa pochwała.",
      "register": "neutral",
      "example": [
        {
          "en": "I've been to many festivals, but nothing compares to Tomorrowland.",
          "pl": "Byłem na wielu festiwalach, ale nic nie dorówna Tomorrowland."
        }
      ],
      "tags": [
        "comparisons",
        "festival"
      ],
      "level": "B1"
    },
    {
      "id": "s6.comparisons.twice-as-expensive",
      "type": "phrase",
      "stage": 6,
      "module": "s6.comparisons",
      "order": 14,
      "en": "It's twice as expensive.",
      "pl": "Jest dwa razy droższe.",
      "alternatives": [
        "It's twice the price."
