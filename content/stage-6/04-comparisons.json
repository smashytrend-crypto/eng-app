      "stage": 6,
      "module": "s6.comparisons",
      "order": 21,
      "en": "than",
      "pl": "niż",
      "alternatives": [],
      "usage": "Słowo do porównań.",
      "register": "neutral",
      "example": [
        {
          "en": "It's bigger than I expected.",
          "pl": "Jest większe, niż się spodziewałem."
