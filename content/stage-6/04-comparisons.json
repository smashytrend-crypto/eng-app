      "stage": 6,
      "module": "s6.comparisons",
      "order": 25,
      "en": "It's much ___ than last year.",
      "pl": "Jest dużo ___ niż w zeszłym roku.",
      "alternatives": [],
      "usage": "Porównanie z „much”.",
      "register": "neutral",
      "example": [
        {
          "en": "It's much bigger than last year.",
          "pl": "Jest dużo większe niż w zeszłym roku."
        },
        {
          "en": "It's much more expensive than last year.",
          "pl": "Jest dużo droższe niż w zeszłym roku."
        }
      ],
      "note": "Krótkie przymiotniki: -er (bigger). Długie: more … (more expensive).",
      "tags": [
        "comparisons"
      ],
      "level": "A2"
    },
    {
      "id": "s6.comparisons.best-in-world",
