{
  "module": {
    "id": "s6.reactions",
    "stage": 6,
    "order": 2,
    "title": "Reakcje",
    "titleEn": "Reactions",
    "description": "No way!, That makes sense, Lucky you!, Tell me about it! — szybkie reakcje, dzięki którym rozmowa brzmi naturalnie.",
    "tags": [
      "general"
    ]
  },
  "items": [
    {
      "id": "s6.reactions.no-way",
      "type": "phrase",
      "stage": 6,
      "module": "s6.reactions",
      "order": 1,
      "en": "No way!",
      "pl": "Nie gadaj! / Niemożliwe!",
      "alternatives": [
        "No way, really?",
        "Seriously?"
      ],
      "usage": "Zaskoczenie — pozytywne albo negatywne.",
      "register": "casual",
      "example": [
        {
          "en": "I got backstage passes! — No way!",
          "pl": "Mam wejściówki za kulisy! — Nie gadaj!"
        }
      ],
      "tags": [
        "reactions"
      ],
      "level": "A2"
    },
    {
      "id": "s6.reactions.makes-sense",
      "type": "phrase",
      "stage": 6,
      "module": "s6.reactions",
      "order": 2,
      "en": "That makes sense.",
      "pl": "To ma sens.",
      "alternatives": [
        "Makes sense.",
        "OK, that makes sense."
      ],
      "usage": "Rozumiesz i akceptujesz wyjaśnienie.",
      "register": "neutral",
      "example": [
        {
          "en": "We go early because the queue is shorter. — Ah, that makes sense.",
          "pl": "Idziemy wcześniej, bo kolejka jest krótsza. — A, to ma sens."
        }
      ],
      "note": "„Ma sens” = „makes sense” (nie „has sense”).",
      "tags": [
        "reactions",
        "polish-trap"
      ],
      "level": "A2"
    },
    {
      "id": "s6.reactions.oh-no",
      "type": "phrase",
      "stage": 6,
      "module": "s6.reactions",
      "order": 3,
      "en": "Oh no!",
      "pl": "O nie!",
      "alternatives": [
        "Oh no, really?"
      ],
      "usage": "Reakcja na złą wiadomość.",
      "register": "neutral",
      "example": [
        {
          "en": "I lost my wristband. — Oh no! What are you going to do?",
          "pl": "Zgubiłem opaskę. — O nie! Co zrobisz?"
        }
      ],
      "tags": [
        "reactions"
      ],
      "level": "A2"
    },
    {
      "id": "s6.reactions.thats-brilliant",
      "type": "phrase",
      "stage": 6,
      "module": "s6.reactions",
      "order": 4,
      "en": "That's brilliant!",
      "pl": "Świetnie! / Genialnie!",
      "alternatives": [
        "That's great!",
        "That's fantastic!"
      ],
      "usage": "Brytyjska reakcja na dobrą wiadomość.",
      "register": "neutral",
      "example": [
        {
          "en": "I got the job! — That's brilliant! Congratulations!",
          "pl": "Dostałem pracę! — Świetnie! Gratulacje!"
        }
      ],
      "tags": [
        "reactions",
        "uk-us"
      ],
      "level": "A2"
    },
    {
