    {
      "id": "s1.numbers-money.how-much-is-it",
      "type": "phrase",
      "stage": 1,
      "module": "s1.numbers-money",
      "order": 1,
      "en": "How much is it?",
      "pl": "Ile to kosztuje?",
      "alternatives": [
        "How much is this?",
        "How much does it cost?",
        "How much is that?"
      ],
      "usage": "Podstawowe pytanie o cenę — w sklepie, na straganie, w barze.",
      "register": "neutral",
      "example": [
        {
          "en": "How much is it? — Eight euros.",
          "pl": "Ile to kosztuje? — Osiem euro."
        }
      ],
      "tags": [
        "numbers",
        "starter"
      ],
      "level": "A2"
    },
    {
      "id": "s1.numbers-money.how-much-are-the-tickets",
      "type": "phrase",
      "stage": 1,
      "module": "s1.numbers-money",
      "order": 2,
      "en": "How much are the tickets?",
      "pl": "Ile kosztują bilety?",
      "alternatives": [
        "How much do the tickets cost?",
        "How much are tickets?"
      ],
      "usage": "Pytanie o cenę kilku rzeczy — liczba mnoga.",
      "register": "neutral",
      "example": [
        {
          "en": "How much are the tickets? — Thirty euros each.",
          "pl": "Ile kosztują bilety? — Po trzydzieści euro."
        }
