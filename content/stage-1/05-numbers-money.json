      "stage": 1,
      "module": "s1.numbers-money",
      "order": 3,
      "en": "Can I pay by card?",
      "pl": "Mogę zapłacić kartą?",
      "alternatives": [
        "Can I pay with a card?",
        "Do you take cards?",
        "Can I pay by card, please?",
        "Is card OK?"
      ],
      "usage": "Zanim zamówisz albo przy kasie.",
      "register": "neutral",
      "example": [
        {
          "en": "Can I pay by card? — Sure, just tap it here.",
          "pl": "Mogę zapłacić kartą? — Jasne, proszę przyłożyć tutaj."
        }
