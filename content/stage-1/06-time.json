      "alternatives": [
        "What time works for you?",
        "When is good for you?",
        "When suits you?"
      ],
      "usage": "Pytasz, kiedy drugiej osobie pasuje.",
      "register": "neutral",
      "example": [
        {
          "en": "What time is good for you? — Anytime after five.",
          "pl": "Która godzina ci pasuje? — Każda po piątej."
        }
      ],
      "tags": [
        "time"
      ],
      "level": "A2"
    },
    {
      "id": "s1.time.busy-on-friday",
      "type": "phrase",
      "stage": 1,
      "module": "s1.time",
      "order": 10,
      "en": "I'm busy on Friday.",
      "pl": "W piątek jestem zajęty.",
