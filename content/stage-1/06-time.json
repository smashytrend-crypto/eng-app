  "items": [
    {
      "id": "s1.time.what-time-is-it",
      "type": "phrase",
      "stage": 1,
      "module": "s1.time",
      "order": 1,
      "en": "What time is it?",
      "pl": "Która godzina?",
      "alternatives": [
        "What's the time?",
        "Do you know what time it is?",
        "Have you got the time?"
      ],
      "usage": "Pytasz o godzinę.",
      "register": "neutral",
      "example": [
        {
          "en": "What time is it? — It's almost midnight.",
          "pl": "Która godzina? — Prawie północ."
        }
      ],
      "tags": [
        "time",
        "starter"
      ],
      "level": "A2"
    },
    {
      "id": "s1.time.half-past-seven",
      "type": "phrase",
      "stage": 1,
      "module": "s1.time",
      "order": 2,
      "en": "It's half past seven.",
      "pl": "Jest wpół do ósmej. (7:30)",
      "alternatives": [
        "It's seven thirty."
      ],
      "usage": "Podajesz godzinę „i pół”.",
      "register": "neutral",
      "example": [
        {
          "en": "What time is it? — It's half past seven.",
          "pl": "Która godzina? — Wpół do ósmej."
        }
      ],
      "note": "Uwaga: „half past seven” to 7:30 — czyli po polsku „wpół do ÓSMEJ”. Liczysz od pełnej godziny, która minęła.",
      "tags": [
        "time",
        "polish-trap"
      ],
      "level": "A2"
    },
    {
      "id": "s1.time.finish-work",
      "type": "phrase",
      "stage": 1,
      "module": "s1.time",
      "order": 3,
      "en": "What time do you finish work?",
      "pl": "O której kończysz pracę?",
      "alternatives": [
        "When do you finish work?",
        "What time do you get off work?"
      ],
      "usage": "Pytasz, kiedy ktoś będzie wolny.",
      "register": "neutral",
      "example": [
        {
          "en": "What time do you finish work? — Usually at four.",
          "pl": "O której kończysz pracę? — Zwykle o czwartej."
        }
      ],
      "tags": [
        "time",
        "work",
        "gr:present-simple",
        "gr:questions-do"
      ],
      "level": "A2"
    },
    {
      "id": "s1.time.free-tomorrow",
      "type": "phrase",
      "stage": 1,
      "module": "s1.time",
      "order": 4,
      "en": "Are you free tomorrow?",
      "pl": "Masz jutro czas?",
      "alternatives": [
        "Are you free tomorrow evening?",
        "Are you around tomorrow?"
      ],
      "usage": "Zanim zaproponujesz spotkanie.",
      "register": "neutral",
      "example": [
        {
          "en": "Are you free tomorrow? — Yeah, after six.",
          "pl": "Masz jutro czas? — Tak, po szóstej."
        }
      ],
      "note": "„Masz czas?” to nie „Do you have time?” — naturalniej: „Are you free?”.",
      "tags": [
        "time",
        "polish-trap",
        "starter"
      ],
      "level": "A2"
    },
    {
      "id": "s1.time.does-seven-work",
      "type": "phrase",
      "stage": 1,
      "module": "s1.time",
      "order": 5,
      "en": "Does seven work for you?",
      "pl": "Pasuje ci siódma?",
      "alternatives": [
        "Is seven OK for you?",
        "Is seven good for you?",
        "How about seven?"
      ],
      "usage": "Proponujesz godzinę i pytasz, czy pasuje.",
      "register": "neutral",
      "example": [
        {
          "en": "Does seven work for you? — Perfect.",
          "pl": "Pasuje ci siódma? — Idealnie."
        }
      ],
      "tags": [
        "time",
        "gr:questions-do"
      ],
      "level": "B1"
    },
    {
      "id": "s1.time.running-late",
      "type": "phrase",
      "stage": 1,
      "module": "s1.time",
      "order": 6,
      "en": "Sorry, I'm running late.",
      "pl": "Sorry, trochę się spóźnię.",
      "alternatives": [
        "Sorry, I'm a bit late.",
        "Sorry, I'm going to be late.",
        "Sorry, I'll be a bit late."
      ],
      "usage": "SMS albo telefon, gdy wiesz, że nie zdążysz na czas.",
      "register": "neutral",
      "example": [
        {
          "en": "Sorry, I'm running late. The tram is stuck.",
          "pl": "Sorry, spóźnię się. Tramwaj utknął."
        }
      ],
      "tags": [
        "time"
      ],
      "level": "B1"
    },
    {
      "id": "s1.time.there-in-ten",
      "type": "phrase",
      "stage": 1,
      "module": "s1.time",
      "order": 7,
      "en": "I'll be there in ten minutes.",
      "pl": "Będę za dziesięć minut.",
      "alternatives": [
        "I'm ten minutes away.",
        "I'll be there in about ten minutes."
      ],
      "usage": "Mówisz, za ile dotrzesz.",
      "register": "neutral",
      "example": [
        {
          "en": "Where are you? — I'll be there in ten minutes.",
          "pl": "Gdzie jesteś? — Będę za dziesięć minut."
        }
      ],
      "note": "„Za dziesięć minut” = „IN ten minutes”. Nie „after ten minutes”.",
      "tags": [
        "time",
        "polish-trap"
      ],
      "level": "A2"
    },
    {
      "id": "s1.time.see-you-then",
      "type": "phrase",
      "stage": 1,
      "module": "s1.time",
      "order": 8,
      "en": "See you then!",
      "pl": "To do zobaczenia!",
      "alternatives": [
        "See you there!",
        "See you later, then!"
      ],
      "usage": "Kończysz umawianie się — wszystko ustalone.",
      "register": "casual",
      "example": [
        {
          "en": "Let's meet at eight at the entrance. — OK, see you then!",
          "pl": "Spotkajmy się o ósmej przy wejściu. — OK, do zobaczenia!"
        }
      ],
      "tags": [
        "time"
      ],
      "level": "A2"
    },
    {
      "id": "s1.time.what-time-good",
      "type": "phrase",
      "stage": 1,
      "module": "s1.time",
      "order": 9,
      "en": "What time is good for you?",
