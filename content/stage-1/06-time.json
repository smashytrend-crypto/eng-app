      "usage": "Gdy proponowana godzina jest dla ciebie za wczesna.",
      "register": "neutral",
      "example": [
        {
          "en": "Let's meet at six. — Can we make it a bit later? I finish work at six.",
          "pl": "Spotkajmy się o szóstej. — Możemy trochę później? Kończę pracę o szóstej."
        }
      ],
      "tags": [
        "time"
      ],
      "level": "B1"
    },
