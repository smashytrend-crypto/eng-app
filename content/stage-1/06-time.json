        "I'm busy on Friday, sorry.",
        "Sorry, I can't on Friday."
      ],
      "usage": "Grzecznie odmawiasz terminu.",
      "register": "neutral",
      "example": [
        {
          "en": "How about Friday? — Sorry, I'm busy on Friday. What about Saturday?",
          "pl": "Może w piątek? — Sorry, w piątek jestem zajęty. A sobota?"
        }
      ],
      "note": "Dni tygodnia z „on”: on Friday, on Saturday morning.",
      "tags": [
        "time"
      ],
      "level": "A2"
    },
    {
      "id": "s1.time.a-bit-later",
      "type": "phrase",
      "stage": 1,
      "module": "s1.time",
      "order": 11,
      "en": "Can we make it a bit later?",
