      "level": "A2"
    },
    {
      "id": "s1.dates-plans.ive-got-plans",
      "type": "phrase",
      "stage": 1,
      "module": "s1.dates-plans",
      "order": 8,
      "en": "I've got plans.",
      "pl": "Mam plany. (jestem umówiony)",
