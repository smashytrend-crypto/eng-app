      "type": "phrase",
      "stage": 1,
      "module": "s1.dates-plans",
      "order": 1,
      "en": "What's the date today?",
      "pl": "Którego jest dzisiaj?",
      "alternatives": [
        "What's today's date?",
        "What's the date?"
      ],
      "usage": "Pytasz o datę.",
      "register": "neutral",
      "example": [
        {
          "en": "What's the date today? — It's the third.",
          "pl": "Którego jest dzisiaj? — Trzeciego."
        }
      ],
      "tags": [
        "time"
      ],
      "level": "A2"
    },
    {
      "id": "s1.dates-plans.first-of-july",
      "type": "phrase",
      "stage": 1,
      "module": "s1.dates-plans",
      "order": 2,
      "en": "It's the first of July.",
      "pl": "Jest pierwszy lipca.",
      "alternatives": [
        "It's July the first.",
        "It's July first."
      ],
      "usage": "Podajesz datę.",
      "register": "neutral",
      "example": [
        {
          "en": "When does it start? — On the first of July.",
          "pl": "Kiedy się zaczyna? — Pierwszego lipca."
        }
      ],
      "note": "UK: the first of July, US: July first. Daty czytamy liczebnikami porządkowymi: first, second, third…",
      "tags": [
        "time",
        "uk-us"
      ],
      "level": "A2"
    },
    {
      "id": "s1.dates-plans.when-birthday",
      "type": "phrase",
      "stage": 1,
      "module": "s1.dates-plans",
      "order": 3,
      "en": "When's your birthday?",
      "pl": "Kiedy masz urodziny?",
      "alternatives": [],
      "usage": "Pytasz o urodziny.",
      "register": "neutral",
      "example": [
        {
          "en": "When's your birthday? — In March. The twelfth.",
          "pl": "Kiedy masz urodziny? — W marcu. Dwunastego."
        }
      ],
      "tags": [
        "time"
      ],
      "level": "A2"
    },
    {
      "id": "s1.dates-plans.birthday-in-march",
      "type": "phrase",
      "stage": 1,
      "module": "s1.dates-plans",
      "order": 4,
      "en": "My birthday is in March.",
      "pl": "Urodziny mam w marcu.",
      "alternatives": [
        "My birthday's in March.",
        "It's in March."
      ],
      "usage": "Mówisz, w jakim miesiącu masz urodziny.",
      "register": "neutral",
      "example": [
        {
          "en": "My birthday is in March, on the twelfth.",
          "pl": "Urodziny mam w marcu, dwunastego."
        }
      ],
      "note": "Miesiące z „in”, dni i daty z „on”: in March, on Monday, on the 12th of March.",
      "tags": [
        "time",
        "polish-trap"
      ],
      "level": "A2"
    },
    {
      "id": "s1.dates-plans.going-to-berlin-friday",
      "type": "phrase",
      "stage": 1,
      "module": "s1.dates-plans",
      "order": 5,
      "en": "I'm going to Berlin on Friday.",
      "pl": "W piątek jadę do Berlina.",
      "alternatives": [
        "I'm going to Berlin this Friday.",
        "On Friday I'm going to Berlin."
      ],
      "usage": "Mówisz o ustalonym wyjeździe.",
      "register": "neutral",
      "example": [
        {
          "en": "I'm going to Berlin on Friday. There's a big party at Tresor.",
          "pl": "W piątek jadę do Berlina. Jest duża impreza w Tresorze."
        }
      ],
      "note": "Ustalony plan = Present Continuous: I'm going (bilety kupione, wszystko jasne).",
      "tags": [
        "gr:present-continuous-future",
        "travel",
        "music"
      ],
      "level": "A2"
    },
    {
      "id": "s1.dates-plans.learn-english-this-year",
      "type": "phrase",
      "stage": 1,
      "module": "s1.dates-plans",
      "order": 6,
      "en": "I'm going to learn English this year.",
      "pl": "W tym roku nauczę się angielskiego.",
      "alternatives": [
        "This year I'm going to learn English."
      ],
      "usage": "Mówisz o postanowieniu — to twój cel.",
      "register": "neutral",
      "example": [
        {
          "en": "I'm going to learn English this year. I want to talk to people at festivals.",
          "pl": "W tym roku nauczę się angielskiego. Chcę rozmawiać z ludźmi na festiwalach."
        }
      ],
      "note": "Zamiar = „going to” + czasownik. Polskie „nauczę się” to tu „I'm going to learn”, nie „I will learn”.",
      "tags": [
        "gr:going-to"
      ],
      "level": "A2"
    },
    {
      "id": "s1.dates-plans.what-day-is-it",
      "type": "phrase",
      "stage": 1,
      "module": "s1.dates-plans",
      "order": 7,
      "en": "What day is it today?",
