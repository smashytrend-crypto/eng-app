      "tags": [
        "time"
      ],
      "level": "A2"
    },
    {
      "id": "s1.dates-plans.maybe-next-time",
      "type": "phrase",
      "stage": 1,
      "module": "s1.dates-plans",
      "order": 9,
      "en": "Maybe next time.",
      "pl": "Może następnym razem.",
      "alternatives": [
        "Maybe another time.",
        "Next time, maybe."
      ],
      "usage": "Odmawiasz, ale zostawiasz otwarte drzwi.",
      "register": "neutral",
      "example": [
        {
          "en": "Sorry, I can't tonight. Maybe next time? — Sure!",
          "pl": "Sorry, dziś nie mogę. Może następnym razem? — Jasne!"
        }
      ],
      "tags": [
        "starter"
      ],
      "level": "A2"
    },
    {
