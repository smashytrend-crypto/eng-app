    },
    {
      "id": "s1.dates-plans.in-two-weeks",
      "type": "phrase",
      "stage": 1,
      "module": "s1.dates-plans",
      "order": 12,
      "en": "It's in two weeks.",
      "pl": "To za dwa tygodnie.",
