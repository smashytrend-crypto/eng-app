      ],
      "usage": "Grzecznie mówisz, że nie możesz.",
      "register": "neutral",
      "example": [
        {
          "en": "Do you want to come tonight? — Sorry, I've got plans.",
          "pl": "Chcesz przyjść dziś wieczorem? — Sorry, mam plany."
